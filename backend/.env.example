# AI Trust Analyzer backend environment template
# Do not commit real secrets. Keep this file as placeholders only.

# When are Supabase keys used?
# - Current behavior: backend settings validate these as non-empty at startup.
# - SUPABASE_URL: used to resolve JWKS endpoint for JWT verification strategy "jwks".
# - SUPABASE_JWT_SECRET: used now for guest-session token signing and HS256 JWT verification fallback.
# - SUPABASE_SERVICE_ROLE_KEY: used now by POST /api/v1/guest/cleanup-expired via X-Service-Role-Key.
# - SUPABASE_ANON_KEY: reserved for Supabase client-side flows; currently required by config validation
#   but not yet consumed directly in backend runtime code paths.

# [REQUIRED] Gemini API key for LLM calls.
GEMINI_API_KEY=your_gemini_api_key_here

# [REQUIRED] Tavily API key for web retrieval.
TAVILY_API_KEY=your_tavily_api_key_here

# [OPTIONAL] Runtime environment.
# Default: development
# Allowed: development | production | test
ENVIRONMENT=development

# [REQUIRED] Database URL.
# In development and production this MUST use asyncpg:
#   postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
# Supabase example:
DATABASE_URL=postgresql+asyncpg://postgres:password@db.project-ref.supabase.co:5432/postgres
# Local PostgreSQL fallback example (still asyncpg):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_trust_analyzer

# [REQUIRED] Supabase project URL.
# Example: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# [REQUIRED] Supabase anon key.
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# [REQUIRED] Supabase service role key.
# Used by protected backend operations (for example cleanup endpoints).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# [REQUIRED] JWT secret for HS256 verification fallback and internal checks.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# [OPTIONAL] JWT verification strategy.
# Default: jwks
# Allowed: jwks | hs256
# Use jwks in production.
SUPABASE_JWT_VERIFY_STRATEGY=jwks

# [OPTIONAL] Expected JWT issuer claim (iss).
# Default: empty (not enforced)
SUPABASE_JWT_ISSUER=

# [OPTIONAL] Expected JWT audience claim (aud).
# Default: empty (not enforced)
SUPABASE_JWT_AUDIENCE=

# [OPTIONAL] Explicit JWKS URL override.
# Default when empty: <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# [OPTIONAL] Allowed CORS origins.
# Default: ["http://localhost:3000"]
# Supports JSON array string or comma-separated values.
ALLOWED_ORIGINS=["http://localhost:3000"]

# [OPTIONAL] Application log level.
# Default: INFO
LOG_LEVEL=INFO

# [OPTIONAL] Maximum claims extracted per analysis.
# Default: 50
MAX_CLAIMS=50

# [OPTIONAL] Embedding vector dimension for pgvector.
# Default: 384
VECTOR_EMBEDDING_DIM=384

# [OPTIONAL] Guest session data retention window in hours.
# Default: 24
GUEST_SESSION_TTL_HOURS=24
