# Required API keys
GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Supabase / PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@db.project-ref.supabase.co:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# JWT verification strategy: jwks (recommended production) or hs256 (development fallback)
SUPABASE_JWT_VERIFY_STRATEGY=jwks
# Optional strict claim checks (enable in production)
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
# Optional override; defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json when empty
SUPABASE_JWKS_URL=

# Optional settings with defaults
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
MAX_CLAIMS=50
VECTOR_EMBEDDING_DIM=384
GUEST_SESSION_TTL_HOURS=24
